{
  "name": "oneday-v3",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs && turbo run test",
    "lint": "eslint .",
    "format:check": "prettier --check . --ignore-unknown",
    "format": "prettier --write . --ignore-unknown",
    "commitlint": "commitlint --from HEAD~1 --to HEAD",
    "db:migrate": "pnpm --filter @oneday/database migrate",
    "db:rollback": "pnpm --filter @oneday/database migrate:down",
    "db:repair": "pnpm --filter @oneday/database migrate:repair",
    "db:seed": "pnpm --filter @oneday/database seed",
    "db:test:prepare": "pnpm --filter @oneday/database test:prepare",
    "db:recovery:clone": "pnpm --filter @oneday/database recovery:clone",
    "human-pilot:seed": "node scripts/local-human-pilot-seed.mjs",
    "human-pilot:start": "powershell -ExecutionPolicy Bypass -File scripts/local-human-pilot-start.ps1",
    "unattended:once": "powershell -ExecutionPolicy Bypass -File scripts/local-unattended-orchestrator.ps1",
    "unattended:install": "powershell -ExecutionPolicy Bypass -File scripts/install-local-unattended-task.ps1",
    "unattended:install:dedicated": "powershell -ExecutionPolicy Bypass -File scripts/install-dedicated-build-machine.ps1",
    "unattended:daemon": "powershell -ExecutionPolicy Bypass -File scripts/local-unattended-daemon.ps1",
    "unattended:status": "powershell -ExecutionPolicy Bypass -File scripts/unattended-status.ps1",
    "fixtures:generate": "node scripts/generate-commercial-fixtures.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "evidence:check": "node tests/evidence-contract.test.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.55.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.7.4",
    "turbo": "2.10.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "overrides": {
      "find-my-way": "9.7.0"
    }
  }
}
