# Copy to .env.local-unattended (gitignored). Used by scripts/local-unattended-construction.ps1

# --- Plan B (recommended): OpenCode + DeepSeek API ---
UNATTENDED_EXECUTOR=opencode
UNATTENDED_OPENCODE_MODEL=deepseek/deepseek-chat
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# --- Plan A (legacy): Cursor Headless — unstable on Free tier ---
# UNATTENDED_EXECUTOR=cursor
# CURSOR_API_KEY=your_cursor_api_key_here

UNATTENDED_CHAIN_MODE=1
# Max wait per daemon loop. Idle sleep is 15s slices; lock-release / .wake starts next turn immediately.
UNATTENDED_POLL_MINUTES=20
UNATTENDED_CHAIN_WAIT_MIN=1

# Adaptive scheduling (non-chain floor; chain uses UNATTENDED_CHAIN_WAIT_MIN)
UNATTENDED_MIN_INTERVAL_MIN=10
UNATTENDED_MAX_INTERVAL_MIN=90
UNATTENDED_USAGE_LIMIT_WAIT_MIN=360
UNATTENDED_MAX_MINUTES_SMALL=60
UNATTENDED_MAX_MINUTES_MEDIUM=120
UNATTENDED_MAX_MINUTES_LARGE=180
UNATTENDED_WAIT_SMALL_MIN=15
UNATTENDED_WAIT_MEDIUM_MIN=25
UNATTENDED_WAIT_LARGE_MIN=45
