# ONEDAY V3 Phase-1 pilot — copy to local secret store; never commit filled values.

# Database (managed PostgreSQL or CVM-hosted Postgres)
DATABASE_URL=

# API
NODE_ENV=production
PORT=3001
PUBLIC_BASE_URL=https://api.example.com
AUTH_TOKEN_SECRET=
CORS_ORIGINS=https://c.example.com,https://e.example.com,https://m.example.com,https://p.example.com
TLS_TERMINATED_BY_PROXY=true
TRUST_PROXY=true
RATE_LIMIT_TRUSTED_EDGE=true
RATE_LIMIT_NAMESPACE=pilot-2026
DATABASE_POOL_MAX=20

# Worker
HEALTH_PORT=3002

# Next.js webs (build-time / runtime public API origin)
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Optional tuning
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_PUBLIC_WRITE_MAX=60
