# TLS-terminated reverse proxy template for Phase-1 pilot (P1-C).
# Replace EXAMPLE domains and certificate paths before use.
# Authorization G must be lifted before public deployment.

upstream oneday_api {
  server 127.0.0.1:3001;
  keepalive 32;
}

upstream oneday_consumer {
  server 127.0.0.1:3201;
}

upstream oneday_employee {
  server 127.0.0.1:3202;
}

upstream oneday_management {
  server 127.0.0.1:3203;
}

upstream oneday_platform {
  server 127.0.0.1:3204;
}

server {
  listen 443 ssl http2;
  server_name api.example.com;
  ssl_certificate     /etc/ssl/certs/oneday-api.fullchain.pem;
  ssl_certificate_key /etc/ssl/private/oneday-api.key.pem;

  location / {
    proxy_pass http://oneday_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }
}

server {
  listen 443 ssl http2;
  server_name c.example.com;
  ssl_certificate     /etc/ssl/certs/oneday-web.fullchain.pem;
  ssl_certificate_key /etc/ssl/private/oneday-web.key.pem;

  location / {
    proxy_pass http://oneday_consumer;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
  }
}

server {
  listen 443 ssl http2;
  server_name e.example.com;
  ssl_certificate     /etc/ssl/certs/oneday-web.fullchain.pem;
  ssl_certificate_key /etc/ssl/private/oneday-web.key.pem;

  location / {
    proxy_pass http://oneday_employee;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
  }
}

server {
  listen 443 ssl http2;
  server_name m.example.com;
  ssl_certificate     /etc/ssl/certs/oneday-web.fullchain.pem;
  ssl_certificate_key /etc/ssl/private/oneday-web.key.pem;

  location / {
    proxy_pass http://oneday_management;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
  }
}

server {
  listen 443 ssl http2;
  server_name p.example.com;
  ssl_certificate     /etc/ssl/certs/oneday-web.fullchain.pem;
  ssl_certificate_key /etc/ssl/private/oneday-web.key.pem;

  location / {
    proxy_pass http://oneday_platform;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
  }
}

server {
  listen 80;
  server_name api.example.com c.example.com e.example.com m.example.com p.example.com;
  return 301 https://$host$request_uri;
}
